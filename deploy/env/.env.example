# Environment template for the local stack (deploy/docker-compose.yml).
#
# Copy it to deploy/env/.env (Git ignores it) and change the values:
#   cp deploy/env/.env.example deploy/env/.env
#
# Every value here is a placeholder for local development only. Replace all
# passwords before any shared use. Variables are added together with the code
# that reads them; a unit test keeps this file and the compose file in step.

# --- PostgreSQL --------------------------------------------------------------
# Credentials are applied only when the data volume is first created. After
# changing them, reset the volume: docker compose ... down -v
POSTGRES_DB=xype
# Superuser: used only inside the postgres container for initialisation.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev-only-change-me-superuser
# Schema owner: owns the database; only the one-shot migrate service uses it.
POSTGRES_OWNER_USER=xype_owner
POSTGRES_OWNER_PASSWORD=dev-only-change-me-owner
# Runtime role of the backend: reads and writes rows, cannot change the schema.
POSTGRES_APP_USER=xype_app
POSTGRES_APP_PASSWORD=dev-only-change-me-app

# --- Redis -------------------------------------------------------------------
# Default user: the container healthcheck and operators only.
REDIS_PASSWORD=dev-only-change-me-redis
# The backend's ACL user, without dangerous or admin commands.
REDIS_BACKEND_USER=backend
REDIS_BACKEND_PASSWORD=dev-only-change-me-redis-backend

# --- RabbitMQ ----------------------------------------------------------------
# Users and permissions are applied on every broker start. There is no "guest" user.
RABBITMQ_VHOST=xype
RABBITMQ_BACKEND_USER=backend
RABBITMQ_BACKEND_PASSWORD=dev-only-change-me-rabbitmq-backend

# --- Auth (ADR-0014) ---------------------------------------------------------
# No placeholders: a key everyone can read would let anyone sign tokens. Generate
# each value once and paste it here (docs/runbooks/local-dev.md):
#   python tools/server_tool.py python -m backend.admin_cli new-key signing-1
#   python tools/server_tool.py python -m backend.admin_cli new-key pepper-1
# The stack refuses to start while they are empty. *_PREVIOUS only verifies during
# a rotation; leave it empty otherwise.
AUTH_SIGNING_KEY_CURRENT=
AUTH_SIGNING_KEY_PREVIOUS=
AUTH_PEPPER_CURRENT=
AUTH_PEPPER_PREVIOUS=
# Requests per user and minute, REST calls and stream messages alike.
RATE_LIMIT_PER_MINUTE=200

# --- Backend -----------------------------------------------------------------
# Host port of the API (HTTPS only, dev CA in deploy/certs/), bound to 127.0.0.1.
BACKEND_PORT=8000
# DEBUG, INFO, WARNING, ERROR or CRITICAL; json (containers) or console.
LOG_LEVEL=INFO
LOG_FORMAT=json
# OTLP/HTTP collector, with the observability profile: http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Ollama ------------------------------------------------------------------
# Space-separated models pulled by the ollama-pull service (ADR-0002, ADR-0003).
OLLAMA_PULL_MODELS=qwen2.5-coder:1.5b qwen3-embedding:0.6b
# 1 re-pulls the models on the next start (needs internet); 0 skips present ones.
OLLAMA_REFRESH=0
# How long an idle model stays in memory.
OLLAMA_KEEP_ALIVE=10m
# Context window in tokens; larger values need more memory.
OLLAMA_CONTEXT_LENGTH=4096

# --- Observability profile ---------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev-only-change-me-grafana
# Host ports, bound to 127.0.0.1 only.
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
