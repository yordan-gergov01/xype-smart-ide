{
  "about": "Synthetic cases only, never a real secret. Each input and expected text is stored as fragments of at most 8 characters, joined by the tests, so secret scanners never see a whole token (ADR-0019).",
  "cases": [
    {
      "name": "private-key-block",
      "input": [
        "KEY = \"\"",
        "\"-----BE",
        "GIN RSA ",
        "PRIVATE ",
        "KEY-----",
        "\nZmFrZS1",
        "rZXktZm9",
        "yLXRlc3R",
        "zLW9ubHk",
        "tbm90LXJ",
        "lYWw=\nZm",
        "FrZS1rZX",
        "ktZm9yLX",
        "Rlc3RzLW",
        "9ubHktbm",
        "90LXJlYW",
        "w=\n-----",
        "END RSA ",
        "PRIVATE ",
        "KEY-----",
        "\"\"\"\nx = ",
        "1\n"
      ],
      "expected": ["KEY = \"\"", "\"<SECRET", "_REMOVED", ">\n\n\n\"\"\"\n", "x = 1\n"],
      "findings": {
        "private-key": 1
      }
    },
    {
      "name": "aws-access-key-id",
      "input": ["aws_acce", "ss_key_i", "d = AKIA", "IOSFODNN", "7EXAMPLE", "\n"],
      "expected": ["aws_acce", "ss_key_i", "d = <SEC", "RET_REMO", "VED>\n"],
      "findings": {
        "aws-access-key-id": 1
      }
    },
    {
      "name": "github-token-in-yaml",
      "input": ["env:\n  G", "H: ghp_F", "AKEfakeF", "AKEfakeF", "AKEfakeF", "AKEfake0", "000\n"],
      "expected": ["env:\n  G", "H: <SECR", "ET_REMOV", "ED>\n"],
      "findings": {
        "github-token": 1
      }
    },
