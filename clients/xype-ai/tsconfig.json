{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "exactOptionalPropertyTypes": true,
    "allowJs": true,
    "checkJs": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "scripts/**/*.mjs", "vitest.config.ts"]
}
