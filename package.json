{
  "name": "xype-smart-ide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "clients/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test .claude/hooks/hooks.test.mjs",
    "dup": "jscpd",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run dup"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jscpd": "5.4.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
