# Direct runtime dependencies of the backend service (ADR-0007).
# Compile before dev.txt; see server/README.md, "Adding or upgrading a dependency".
# HTTP API and its server.
fastapi
uvicorn
pydantic
# Settings from environment variables only (ADR-0010).
pydantic-settings
# Structured JSON logs (ADR-0011).
structlog
# Database access (brief §1): SQLAlchemy 2 async on asyncpg.
sqlalchemy[asyncio]
asyncpg
# Schema migrations (brief §1); run by the one-shot migrate service.
alembic
# The vector(1024) column type for SQLAlchemy.
pgvector
# Redis cache (brief §1).
redis
# RabbitMQ client; the readiness probe connects with it.
aio-pika
# AES-256-GCM, X25519, HKDF and HMAC for payload encryption and key wrapping
# (ADR-0015, ADR-0016); the standard library has no AEAD or X25519.
cryptography
# HTTP client of the embedder (Ollama, TEI) and later the connectors.
httpx
# Metrics and traces (ADR-0011).
prometheus-client
opentelemetry-api
opentelemetry-sdk
opentelemetry-exporter-otlp-proto-http
