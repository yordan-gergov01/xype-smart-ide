# Only what the Dockerfiles copy is needed; keep the build context small and free
# of secrets and the local virtual environment.
*
!backend/
!migrations/
!alembic.ini
!common_lib/
!requirements/
!tests/
# The dev CA generator, for the test stage only (the runtime stage never copies it).
!devtools/
!pyproject.toml

# Never copy secrets that may sit inside the included folders.
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx

**/__pycache__/
**/*.py[cod]
